# EdgeDrive3D Telegram Bot - Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# TELEGRAM BOT CONFIGURATION
# =============================================================================

# Get your bot token from @BotFather on Telegram
# Example: 1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Authorized user IDs (comma-separated)
# Get your user ID from @userinfobot
# Example: 123456789,987654321,111222333
TELEGRAM_ADMIN_IDS=your_user_id_here

# =============================================================================
# ROBOT CAR CONFIGURATION
# =============================================================================

# ESP32 Motor Controller IP Address
# Find this from ESP32 serial monitor
ESP32_IP=10.217.127.207

# ESP32 Ports
ESP32_COMMAND_PORT=9000
ESP32_STATUS_PORT=9001

# Video Stream Port
UDP_VIDEO_PORT=5000

# =============================================================================
# AUTONOMOUS MODE CONFIGURATION
# =============================================================================

# Enable/disable autonomous mode
# true = AI control enabled
# false = Manual control only
AUTONOMOUS_ENABLED=true

# Path to decision engine (relative to telegram_bot directory)
DECISION_ENGINE_PATH=../../decision_engine

# =============================================================================
# GEOFENCING CONFIGURATION
# =============================================================================

# Enable geofencing
# true = Geofence alerts active
# false = No geofence checks
GEOFENCE_ENABLED=true

# Maximum distance from home position (in meters)
# Robot will alert if it goes beyond this radius
GEOFENCE_RADIUS=100.0

# =============================================================================
# UPDATE INTERVALS (in milliseconds)
# =============================================================================

# Telemetry update interval
TELEMETRY_INTERVAL=5000

# Video frame capture interval
VIDEO_INTERVAL=2000

# GPS position update interval
GPS_INTERVAL=3000

# =============================================================================
# GPS CONFIGURATION
# =============================================================================

# GPS simulation mode
# true = Use simulated GPS data (for testing)
# false = Use real GPS hardware
GPS_SIMULATE=true

# GPS serial port (for hardware mode)
# Windows: COM3, COM4, etc.
# Linux: /dev/ttyUSB0, /dev/ttyAMA0, etc.
GPS_PORT=auto

# GPS baud rate
GPS_BAUDRATE=9600

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file path
LOG_FILE=logs/bot.log

# =============================================================================
# ADVANCED SETTINGS
# =============================================================================

# Maximum number of telemetry data points to store
MAX_TELEMETRY_POINTS=100

# Alert cooldown time (seconds)
# Prevents spamming the same alert
ALERT_COOLDOWN=60

# Command timeout (milliseconds)
COMMAND_TIMEOUT=5000

# =============================================================================
# WEB APP CONFIGURATION
# =============================================================================

# Enable web app interface
WEB_APP_ENABLED=true

# Web app host (for standalone mode)
WEB_APP_HOST=0.0.0.0

# Web app port (for standalone mode)
WEB_APP_PORT=8080

# =============================================================================
# SECURITY SETTINGS
# =============================================================================

# Require authentication for all commands
# true = Check user ID for every command
# false = Allow any user (NOT RECOMMENDED)
REQUIRE_AUTH=true

# Session timeout (seconds)
# User sessions expire after this time of inactivity
SESSION_TIMEOUT=300

# =============================================================================
# NOTIFICATION SETTINGS
# =============================================================================

# Send periodic telemetry updates
# true = Auto-send telemetry every TELEMETRY_INTERVAL
# false = Only send when requested
AUTO_TELEMETRY=true

# Send alert notifications
# true = Send alerts immediately
# false = Log alerts only
ALERT_NOTIFICATIONS=true

# =============================================================================
# PERFORMANCE SETTINGS
# =============================================================================

# Maximum concurrent connections
MAX_CONNECTIONS=10

# Socket buffer size (bytes)
SOCKET_BUFFER_SIZE=65536

# Video frame quality (1-100)
VIDEO_QUALITY=75
